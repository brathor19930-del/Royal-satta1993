        .overlay.active { display: block; }
        .marquee-container { background-color: #cc0000; color: #ffffff; padding: 12px 0; font-size: 14px; font-weight: bold; overflow: hidden; white-space: nowrap; border-bottom: 2px solid #ff4d4d; }
