        .sidebar.active { left: 0; }
        .sidebar-header { background: #222; padding: 20px; display: flex; align-items: center; gap: 15px; border-bottom: 1px solid #333; }
        .user-avatar { font-size: 24px; background: #d4af37; color: #000; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: bold; }
        .user-info .phone { font-weight: bold; color: #d4af37; font-size: 15px; }
        .user-info .status { font-size: 11px; color: #4caf50; }
